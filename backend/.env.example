# Supabase (Postgres) — free tier
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — used to sign/verify the JWT every tenant-scoped API route requires
JWT_SECRET=

# Anthropic (heavy analysis — claude-sonnet-5)
ANTHROPIC_API_KEY=

# Google AI Studio (light extraction — gemini-1.5-flash, free tier)
GOOGLE_AI_API_KEY=

# Telegram — get from https://my.telegram.org (used by both listener.js and login.js)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Only needed if using botListener.js instead of the GramJS personal-account listener:
TELEGRAM_BOT_TOKEN=

# Google Drive service account (JSON key content, as a single-line string)
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Set once deployed (Render/Hugging Face Spaces URL) — enables the keep-alive
# self-ping and the Telegram bot webhook URL.
PUBLIC_URL=

# Comma-separated allowlist of frontend origins allowed to call this API
# (e.g. https://maskanyar.vercel.app,http://localhost:3101). Leave empty for
# local development only — always set this in production.
CORS_ORIGIN=

PORT=3000
